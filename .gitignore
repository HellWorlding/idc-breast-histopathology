# 가상환경
.venv/
# 데이터 (Kaggle 원본, 캐시, 분할 목록은 용량/재배포 문제로 올리지 않음 - 코드로 재생성 가능)
data/*
# 예외: 환자 단위 분할 목록 3개만 올린다 (서버와 데스크톱 분할을 똑같이 맞추기 위해, 환자 ID만 있음)
!data/splits/
data/splits/*
!data/splits/train_patients.csv
!data/splits/val_patients.csv
!data/splits/test_patients.csv
# 큰 산출물
outputs/checkpoints/
outputs/preds/
outputs/patches_index.csv
__pycache__/
*.pyc
# 로컬 작업 메모 - 저장소에 올리지 않음
CLAUDE.md
# 비밀 정보
.env
*.json.key
kaggle.json
access_token
